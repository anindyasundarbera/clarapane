#!/bin/sh
# Rejects commit messages that do not follow Conventional Commits.
#
# Installed by: git config core.hooksPath .githooks
# Bypass (emergencies only): git commit --no-verify
#
# Rules:
#   <type>(<scope>): <subject>
#   * type is one of the allowlisted values below
#   * subject starts lowercase, has no trailing period
#   * subject line max 72 chars
#   * merge/revert commits are exempt

msg_file="$1"
subject=$(head -n 1 "$msg_file")

case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|test|refactor|perf|chore|build|ci)(\([a-z0-9/_-]+\))?: [a-z].*[^.]$'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<EOF
commit-msg: invalid subject

  got: $subject

Required format:  <type>(<scope>): <lowercase subject without trailing period>
Allowed types:     feat fix docs test refactor perf chore build ci
Examples:
  feat(tools): add read_range with capped output
  fix(policy): allow reading the workspace root
  chore: add gitignore and env template

See AGENTS.md for the message body convention (Why / What / Decision / Refs).
EOF
  exit 1
fi

if [ ${#subject} -gt 72 ]; then
  echo "commit-msg: subject is ${#subject} chars, limit is 72" >&2
  exit 1
fi

exit 0
