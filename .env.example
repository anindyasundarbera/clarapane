# Copy to .env and fill in real values. Never commit .env itself.
#
# The provider is any OpenAI-compatible endpoint. Verified against Ollama Cloud:
#   OPENAI_BASE_URL=https://ollama.com/v1
# Model listing uses the native route GET https://ollama.com/api/tags, which is
# the only one that exposes per-model `capabilities` (e.g. "tools").

OPENAI_BASE_URL=https://ollama.com/v1
OPENAI_API_KEY=

# Native Ollama host, used for capability lookups.
OLLAMA_HOST=https://api.ollama.com
OLLAMA_API_KEY=

# Must name a tool-capable model. Check with:
#   PYTHONPATH=src .venv/bin/python scripts/list_models.py
DEFAULT_OLLAMA_MODEL=

# Optional: the agent's display name. Cosmetic only; defaults to Clarapane.
# CLARAPANE_APP_NAME=Clarapane
