#!/bin/sh
# Refuse to commit directly to a protected branch.
#
# Why: this project requires that every change reaches main through a reviewed PR.
# A commit made straight onto main bypasses review, and on 2026-10-21 twenty-eight
# of them did exactly that. A local hook is preventive, not authoritative -- it can be
# bypassed with --no-verify -- so the authoritative control is the GitHub ruleset and
# the detective control is scripts/audit_defects.py.
#
# Protected branches come from PROTECTED_BRANCHES (space-separated), default "main".
# Escape hatch for a deliberate hotfix, recorded in the trace by the audit:
#   ALLOW_PROTECTED_COMMIT=1 git commit ...

protected="${PROTECTED_BRANCHES:-main}"
current=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

for branch in $protected; do
  if [ "$current" = "$branch" ]; then
    if [ "${ALLOW_PROTECTED_COMMIT:-0}" = "1" ]; then
      cat >&2 <<EOF
pre-commit: ALLOW_PROTECTED_COMMIT=1 -- committing to '$current' anyway.
This bypass is visible to scripts/audit_defects.py, which will report it.
EOF
      break
    fi
    cat >&2 <<EOF
pre-commit: refusing to commit directly to '$current'

Every change must reach '$current' through a pull request, so that the diff is
reviewed and the history keeps a link to the discussion. Direct commits are how
28 unreviewed changes landed on main.

Fix:
  git switch -c feat/<short-description>     # recommended
  ALLOW_PROTECTED_COMMIT=1 git commit ...     # deliberate hotfix, will be audited
EOF
    exit 1
  fi
done

# ---- refuse to commit while a tracked run artifact is modified but unstaged ----
# Twice-confirmed failure: a commit staged source changes and left runs/runs.jsonl
# behind, so its own "Evidence:" section cited a trace that was not in the commit.
unstaged=$(git diff --name-only --)
abandoned=$(printf '%s\n' "$unstaged" | grep -E '^runs/' || true)

if [ -n "$abandoned" ]; then
  if [ "${ALLOW_UNSTAGED:-0}" = "1" ]; then
    echo "pre-commit: allowing unstaged run artifacts (ALLOW_UNSTAGED=1):" >&2
    printf '  %s\n' "$abandoned" >&2
    exit 0
  fi
  cat >&2 <<EOF
pre-commit: tracked run artifact(s) modified but NOT staged

$(printf '  %s\n' "$abandoned")

Traces under runs/ are the product of this project. A commit that changes agent
behaviour while leaving the evidence behind makes its own "Evidence:" section
unverifiable.

Fix:
  git add runs/            # include the evidence
  ALLOW_UNSTAGED=1 git commit ...   # only when the trace truly does not belong
EOF
  exit 1
fi

if [ -n "$unstaged" ]; then
  echo "pre-commit: note -- tracked files modified but not staged:" >&2
  printf '  %s\n' "$unstaged" >&2
fi
exit 0
