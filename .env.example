# Copy to .env and fill in real values. Never commit .env itself.
#
# Run `make setup` (or `python scripts/setup_env.py`) to create this file, generate
# CI secrets, and verify the provider works.
#
# The provider is ANY OpenAI-compatible endpoint. Verified against Ollama Cloud:
#   PROVIDER_BASE_URL=https://ollama.com/v1
#
# The names are provider-agnostic on purpose. They used to be OPENAI_*, which
# described the SDK rather than the service and mislabelled an Ollama key. The old
# names are still read as a fallback, so an existing .env keeps working.

PROVIDER_BASE_URL=https://ollama.com/v1

# One key, used for both chat and model listing. Do not duplicate it.
PROVIDER_API_KEY=

# Must name a tool-capable model. Check with:
#   python scripts/list_models.py
PROVIDER_MODEL=

# Optional: the agent's display name. Cosmetic only; defaults to Clarapane.
# CLARAPANE_APP_NAME=Clarapane

# Optional: the accountable human for approvals. Defaults to the OS login.
# Approvals are recorded against this identity, so the trace can answer
# "who allowed this write?". Never leave it empty in a shared environment.
# CLARAPANE_OPERATOR_ID=you@example.com
