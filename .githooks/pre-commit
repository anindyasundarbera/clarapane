#!/bin/sh
# Refuse to commit while a tracked artifact is modified but unstaged.
#
# Why this exists (twice-confirmed failure):
#   1. CLARAPANE_APP_NAME was added to .env.example and code but not to .env.
#   2. A commit staged four source files and abandoned runs/runs.jsonl, so the
#      commit's own "Evidence:" section cited a trace that was not in the commit.
#
# Both came from selective `git add <files>`: the author lists the files they were
# thinking about and omits the peer artifact. This hook makes that omission visible
# at commit time instead of at review time.
#
# Artifacts under runs/ are enforced (they are the product). Other unstaged tracked
# files produce a warning only, because partial staging is sometimes deliberate.
#
# Override deliberately:  ALLOW_UNSTAGED=1 git commit ...
# Prefer:                make commit MSG="..."

unstaged=$(git diff --name-only --)
staged=$(git diff --cached --name-only --)

if [ -z "$unstaged" ]; then
  exit 0
fi

abandoned=$(printf '%s\n' "$unstaged" | grep -E '^runs/' || true)

if [ -n "$abandoned" ]; then
  if [ "${ALLOW_UNSTAGED:-0}" = "1" ]; then
    echo "pre-commit: allowing unstaged run artifacts (ALLOW_UNSTAGED=1):" >&2
    printf '  %s\n' "$abandoned" >&2
    exit 0
  fi
  cat >&2 <<EOF
pre-commit: tracked run artifact(s) modified but NOT staged

$(printf '  %s\n' "$abandoned")

Traces under runs/ are the product of this project. A commit that changes agent
behaviour while leaving the evidence behind makes its own "Evidence:" section
unverifiable.

Fix:
  git add runs/            # include the evidence
  # or, if the trace genuinely does not belong in this commit:
  ALLOW_UNSTAGED=1 git commit ...

Next time use:  make commit MSG="<subject>"
EOF
  exit 1
fi

echo "pre-commit: note -- tracked files modified but not staged:" >&2
printf '  %s\n' "$unstaged" >&2
echo "pre-commit: committing anyway (only runs/ is enforced)" >&2
exit 0
