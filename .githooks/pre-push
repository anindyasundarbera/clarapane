#!/bin/sh
# Refuse to push a protected branch directly.
#
# The authoritative control is the GitHub ruleset (a local hook is bypassed with
# --no-verify or by pushing from another clone). This hook exists so the mistake is
# caught at the earliest possible moment, with a message that says what to do instead.

protected="${PROTECTED_BRANCHES:-main}"
remote="$1"

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/*) target="${remote_ref#refs/heads/}" ;;
    *) continue ;;
  esac

  for branch in $protected; do
    if [ "$target" = "$branch" ]; then
      if [ "${ALLOW_PROTECTED_PUSH:-0}" = "1" ]; then
        echo "pre-push: ALLOW_PROTECTED_PUSH=1 -- pushing to '$branch' anyway." >&2
        break
      fi
      cat >&2 <<EOF
pre-push: refusing to push directly to '$branch' on '$remote'

Push the feature branch and open a pull request instead:
  git push -u origin \$(git symbolic-ref --short HEAD)
  gh pr create --fill

Main is protected by a GitHub ruleset, so a direct push is rejected there too and
this hook only saves the round trip. Neither the ruleset nor this hook guarantees
that a second person reviewed the change -- see AGENTS.md 1c.

Deliberate override (will be reported by scripts/audit_defects.py):
  ALLOW_PROTECTED_PUSH=1 git push ...
EOF
      exit 1
    fi
  done
done

# If a PR already exists for this branch, its description must match its contents.
# A squash merge turns the PR title into main's commit subject, so a stale title
# permanently misdescribes the change.
if command -v gh >/dev/null 2>&1; then
  if python_bin=$([ -x .venv/bin/python ] && echo .venv/bin/python || command -v python3); then
    if [ -n "$python_bin" ] && ! "$python_bin" scripts/check_pr.py --current >/dev/null 2>&1; then
      echo "pre-push: the PR for this branch does not describe its contents." >&2
      "$python_bin" scripts/check_pr.py --current >&2 || true
      echo "Fix it with: gh pr edit --title ... --body-file ..." >&2
    fi
  fi
fi

exit 0
